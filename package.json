    "copy-to-prod": "node --import tsx scripts/copy-to-prod.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.3",
    "pdfjs-dist": "6.3.289",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
